# EdgeLabs local environment — TEMPLATE (committed). Copy to .env and fill.
# .env is gitignored; .env.example is safe to commit.

# --- MT5 DEMO account (MetaQuotes-Demo registration) ---
TL_LOGIN=YOUR_MT5_LOGIN
TL_PASSWORD=YOUR_MT5_PASSWORD
TL_SERVER=MetaQuotes-Demo

# --- Alpaca paper (H5 forward-test) ---
APCA_API_KEY_ID=YOUR_APCA_KEY
APCA_API_SECRET_KEY=YOUR_APCA_SECRET

# --- SAFETY GATES (do NOT enable without explicit '#D#' authorization) ---
# Real DEMO fills require BOTH: EDGELAB_DEMO_FILL=1 AND DEMO_CONFIRM=#D#
EDGELAB_DEMO_FILL=
DEMO_CONFIRM=

# --- Dashboard port ---
DASH_PORT=8080
